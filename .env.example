# PostgreSQL database connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/transcripcion?schema=public"

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# OpenAI models (optional overrides)
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Max upload size in MB. Files larger than ~24MB are automatically compressed
# (mono 32kbps mp3) and chunked into 10-min segments, then merged. So you can
# safely upload long recordings (1-3+ hours) by setting a higher limit here.
MAX_UPLOAD_MB="500"

# Where uploaded audio files are stored on disk
UPLOAD_DIR="./uploads"
